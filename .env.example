# AILink SDK — Environment Configuration
# ─────────────────────────────────────────────
# Copy this file to .env.local and fill in your actual API keys
# Never commit real API keys to version control
#
# Provider Setup:
#   OpenAI:  https://platform.openai.com/api-keys
#   Claude:  https://console.anthropic.com/
#   Gemini:  https://aistudio.google.com → Get API Key (free)
#   Groq:    https://console.groq.com → API Keys (free)

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-key-here

# Claude Configuration
CLAUDE_API_KEY=sk-ant-your-claude-key-here

# Gemini Configuration (free tier available)
GEMINI_KEY=your-gemini-api-key-here

# Groq Configuration (free tier available)
GROQ_KEY=gsk_your-groq-key-here

# Optional: Default provider
# Options: openai, claude, gemini, groq
DEFAULT_PROVIDER=openai

# Optional: Fallback providers (comma-separated)
# Example: claude,gemini,groq
FALLBACK_PROVIDERS=
